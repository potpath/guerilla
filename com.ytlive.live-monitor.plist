<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. Copy to ~/Library/LaunchAgents/ and replace the two placeholders:
    __REPO_DIR__  absolute path to this checkout
    __HOME__      your home directory
  Channel handle and ntfy topic are not set here; they live in env.local
  next to monitor.sh, which is untracked. See README.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ytlive.live-monitor</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__REPO_DIR__/monitor.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>120</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/yt-live-monitor.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/yt-live-monitor.log</string>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
