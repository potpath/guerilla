# Copy to env.local (untracked) and fill in.

# Channel to watch, including the leading @.
HANDLE="@SomeChannel"

# ntfy.sh topic for phone pushes. Leave empty to use macOS notifications only.
# The topic name is the ONLY access control ntfy has: anyone who knows it can
# read your pushes and publish to it. Generate an unguessable one:
#   python3 -c "import secrets; print('yt-live-' + secrets.token_urlsafe(9))"
NTFY_TOPIC=""
